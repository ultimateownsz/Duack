<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Offline authoring CLI: `duackcli init`, `duackcli validate`, `duackcli convert`. This is the ONLY
         Duack project allowed to reference NAudio / OggVorbisEncoder (audio file codecs live here,
         never in src/). Desktop .NET only; never referenced by src/ or samples/. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>DuackCli</RootNamespace>
    <AssemblyName>duackcli</AssemblyName>
    <PackageId>DuackCli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>duackcli</ToolCommandName>
    <Description>Offline Duack tooling: scaffold and validate audio-config.json, and convert WAV masters to OGG for web builds.</Description>
    <IsPackable>true</IsPackable>
    <!-- Invoked from build targets; keep startup cheap and never emit build noise (logo off). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Duack\Duack.csproj" />
    <!-- The provisional JSON layer (not shipped in this preview, but the CLI IS a file tool). -->
    <ProjectReference Include="..\..\src\Duack.Config\Duack.Config.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions mirror MonsterProjectWeb's tools/AudioConverter pins so a converted OGG is
         byte-comparable with the game's web build. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>

</Project>
