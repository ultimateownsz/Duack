<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Offline authoring CLI: `duackcli convert`, `duackcli scan`, `duackcli normalize`. This is the ONLY
         Duack project allowed to reference NAudio / OggVorbisEncoder (audio file codecs live here,
         never in src/). Desktop .NET only; never referenced by src/ or samples/. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>DuackCli</RootNamespace>
    <AssemblyName>duackcli</AssemblyName>
    <PackageId>DuackCli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>duackcli</ToolCommandName>
    <Description>Offline Duack tooling: convert WAV masters to OGG for web builds, scan audio manifests, and normalize track loudness.</Description>
    <IsPackable>true</IsPackable>
    <!-- Invoked from build targets; keep startup cheap and never emit build noise (logo off). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Duack\Duack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pins chosen to match the original audio-converter pipeline so a converted OGG stays
         byte-comparable with builds produced by that tool. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>

</Project>
