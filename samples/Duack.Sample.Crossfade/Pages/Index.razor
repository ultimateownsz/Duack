@page "/"
@page "/index.html"
@inject IJSRuntime JsRuntime

<div id="canvasHolder" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #000;">
    <canvas id="theCanvas" style="touch-action:none;"></canvas>
</div>

@if (_game is Game1 game && _gameRunning)
{
    <div style="position:fixed; top:8px; right:8px; z-index:60; width:min(280px, calc(100vw - 16px)); padding:12px; color:#fff; background:rgba(0,0,0,.86); border:1px solid #596273; border-radius:8px; font-family:system-ui,sans-serif; font-size:.85rem; pointer-events:none;">
        <div style="font-weight:700; margin-bottom:8px;">HTML / Blazor controls</div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; pointer-events:auto;">
            @for (var i = 0; i < game.Tracks.Count; i++)
            {
                var trackIndex = i;
                <button @onclick="() => SelectTrack(trackIndex)" style="cursor:pointer;">@(trackIndex + 1)</button>
            }
            <button @onclick="NextTrack" style="cursor:pointer;">Next</button>
        </div>
        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; pointer-events:auto;">
            @for (var i = 0; i < 4; i++)
            {
                var presetIndex = i;
                <button @onclick="() => SelectPreset(presetIndex)" style="cursor:pointer;">@($"{4 << presetIndex}s")</button>
            }
            <button @onclick="ToggleCrossfade" style="cursor:pointer;">@(game.CrossfadeEnabled ? "Disable" : "Enable") crossfade</button>
        </div>
    </div>
}
