@page "/"
@namespace Duack.Sample.Web
@implements IDisposable

@using Duack
@using Duack.KNI
@using Duack.Sample.Core
@inject HttpClient Http

<h3>Duack — Web Sample (KNI / Blazor WASM)</h3>

<div class="panel">
    <p>@_status</p>

    <div class="row">
        <button @onclick="StartStory" disabled="@(_disabled || _storyRunning)">Start story (gesture)</button>
        <button @onclick="AdvanceStory" disabled="@(!_storyRunning)">Advance (Space)</button>
        <button @onclick="RestartStory" disabled="@(!_storyRunning)">Restart (R)</button>
        <button @onclick="PulseSfx" disabled="@_disabled">Duck pulse (sfx)</button>
    </div>

    <div class="row">
        @foreach (var track in _library?.Tracks ?? Array.Empty<string>())
        {
            var name = track;
            <button @onclick="() => Play(name)" disabled="@_disabled">Play @track</button>
        }
        @if (_library is { Tracks.Count: > 0 })
        {
            <button @onclick='() => Play("music")' disabled="@_disabled">Shuffle "music" playlist</button>
        }
    </div>

    <p>frames: <strong>@_frames</strong> clicks: <strong>@_clicks</strong> loop error: <strong>@(_loopError)</strong></p>

    <p>
        <span class="chip @(_context == "Overworld" ? "green" : _context == "Battle" ? "red" : "blue")"></span>
        Context: <strong>@_context</strong> &nbsp;|&nbsp;
        Duck ratio: <strong>@_duckRatio</strong>
    </p>

    @if (_storyRunning)
    {
        <p>
            Story: <strong>@_story!.Scene</strong>
            @if (_story.Scene == StoryScene.Walk)
            {
                <text>&nbsp;|&nbsp; walk @((int)(_story.WalkProgress * 100))%</text>
            }
            else if (_story.Scene == StoryScene.Dialog)
            {
                <text>&nbsp;|&nbsp; line @(_story.DialogLine + 1) / @StoryController.DialogLineCount</text>
            }
            else if (_story.Scene is StoryScene.Battle or StoryScene.BattleIntro)
            {
                <text>&nbsp;|&nbsp; round @_story.BattleRound &mdash; you @((int)(_story.PlayerHp * 100)) HP, foe @((int)(_story.FoeHp * 100)) HP</text>
            }
        </p>
        <p class="muted">
            Last cue: <strong>@_lastCue</strong> — the web host has no sfx backend, so story cues
            surface as duck pulses over the music (same <code>StoryController</code> as the desktop
            sample; scene music crossfades through the platform player).
        </p>
    }

    <p class="muted">
        The page discovers its tracks from the checked-in <code>audio-manifest.json</code>
        (generated by <code>duack scan</code> — browsers cannot enumerate directories).<br />
        Browsers require a real user gesture before audio plays — "Start story" is that gesture.
    </p>
</div>

@code {
    private MusicDirector? _director;
    private AudioLibrary? _library;
    private StoryController? _story;
    private string _status = "Loading manifest…";
    private string _context = "(none)";
    private string _duckRatio = "1.00";
    private string _lastCue = "(none)";
    private bool _disabled = true;
    private bool _storyRunning;
    private DateTime _last = DateTime.UtcNow;
    private bool _running;
    private int _frames;
    private int _clicks;
    private string _loopError = "";

    private static int _staticClicks;

    /// <summary>Diagnostic: called from JS to prove the .NET dispatcher is processing interop.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public static string Ping() => "pong@" + Environment.TickCount64;

    /// <summary>Diagnostic: .NET-side click count, readable without a re-render.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public static int StaticClicks() => _staticClicks;

    protected override async Task OnInitializedAsync()
    {
        // Music-only on the web: the manifest lists the OGG tracks in wwwroot/Content/Audio/Tracks.
        AudioLibraryManifest manifest;
        try
        {
            var json = await Http.GetStringAsync("Content/Audio/audio-manifest.json");
            manifest = AudioLibraryManifestJson.Deserialize(json);
        }
        catch (Exception ex)
        {
            _status = $"Could not load audio-manifest.json: {ex.Message}";
            return;
        }

        _library = AudioLibrary.FromManifest(manifest);
        if (_library.Tracks.Count == 0)
        {
            _status = "The manifest lists no tracks.";
            return;
        }

        // Same auto-built playlists and same demo mix as the desktop sample — both come from the
        // shared, headless-pinned sample core (Duack.Sample.Core.SampleAudio).
        var playlists = SampleAudio.BuildPlaylists(_library);
        var config = SampleAudio.BuildConfig(playlists);

        // KNI adapter: platform MediaPlayer (HTML <audio> on BlazorGL), non-overlapping, reading
        // the Tracks/ directory the two-directory convention discovered.
        var backend = new MediaPlayerMusicBackend(
            new KniMediaPlayerHost(), contentRoot: "Content/Audio/Tracks", extension: ".ogg");
        _director = new MusicDirector(backend, new MusicPlaylistController(playlists), config.Music);
        _story = new StoryController();

        _director.TrackCompleted += finished =>
        {
            _status = $"Track finished: {finished.Name} ({finished.Context})";
            StateHasChanged();
        };

        _disabled = false;
        _status = $"Discovered {_library.Tracks.Count} tracks: {string.Join(", ", _library.Tracks)}. Click \"Start story\" (browser audio autoplay requires a gesture).";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Start the update loop on whichever render first has the director: OnInitializedAsync
        // yields at the manifest fetch, so the very first render can arrive while _director is
        // still null — gating on firstRender alone would consume the flag and never loop again
        // (music then never plays: no Update => no PlayTrack).
        if (_running || _director is null) return;

        _running = true;
        _last = DateTime.UtcNow;

        // Drive the per-frame update from the Blazor render loop (no game host needed for the demo).
        while (_running)
        {
            try
            {
                await Task.Delay(16);
                if (_director is null) break;
                var now = DateTime.UtcNow;
                var elapsed = (float)(now - _last).TotalSeconds;
                _last = now;
                _director.Update(elapsed);
                if (_storyRunning && _story is not null)
                    ApplyFrame(_story.Update(elapsed));
                _context = _director.CurrentTrack?.Context ?? "(none)";
                _duckRatio = _director.DuckRatio.ToString("0.00");
                _frames++;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _loopError = ex.ToString();
                StateHasChanged();
                _running = false;
            }
        }
    }

    /// <summary>
    /// Feeds one shared-core story frame into the audio system: scene music switch first, then the
    /// sfx cue. The web host has no sfx backend (see the root AGENTS.md known limitation), so cues
    /// surface as duck pulses — the mix reacts exactly like the desktop sample's auto-ducking.
    /// </summary>
    private void ApplyFrame(StoryFrame frame)
    {
        if (frame.SceneChanged)
            _status = $"Story scene: {_story!.Scene}";

        if (frame.Music is not null)
            _director!.Play(frame.Music); // single-track playlist: crossfades from whatever plays

        if (frame.Sfx is not null)
        {
            // Same reaction as the desktop sample's SfxDirector auto-duck: pulse the "sfx" duck
            // source with the configured hold (the -1 default), just without the one-shot audio.
            _director!.Pulse(SampleAudio.SfxDuckSource);
            _lastCue = frame.Pitch == 0f
                ? frame.Sfx
                : $"{frame.Sfx} (pitch {(frame.Pitch > 0 ? "+" : "")}{frame.Pitch:0.00})";
        }
    }

    private void StartStory()
    {
        _clicks++;
        _staticClicks++;
        if (_director is null || _story is null || _storyRunning) return;

        // This click IS the browser's user-activation gesture: music may start now.
        _storyRunning = true;
        _director.Play(StoryController.OverworldPlaylist);
        _status = "Story started — Space advances a beat, R restarts.";
    }

    private void AdvanceStory()
    {
        _clicks++;
        _staticClicks++;
        if (_storyRunning && _story is not null)
            ApplyFrame(_story.Advance());
    }

    private void RestartStory()
    {
        _clicks++;
        _staticClicks++;
        if (_storyRunning && _story is not null)
            ApplyFrame(_story.Restart());
    }

    private void Play(string name)
    {
        _clicks++;
        _staticClicks++;
        if (_director is null) return;
        try
        {
            _director.Play(name);
            _status = $"Playing playlist '{name}'...";
        }
        catch (Exception ex)
        {
            _status = $"Play('{name}') threw: {ex.Message}";
        }
    }

    private void PulseSfx()
    {
        if (_director is null) return;
        _director.Pulse(SampleAudio.SfxDuckSource);
        _status = "SFX duck pulse triggered.";
    }

    public void Dispose() => _running = false;
}
