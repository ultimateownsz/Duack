<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Duack.Sample.Concurrency</RootNamespace>
    <AssemblyName>Duack.Sample.Concurrency</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Duack\Duack.csproj" />
    <ProjectReference Include="..\..\src\Duack.MonoGame\Duack.MonoGame.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
  <!-- Reuse the existing SFX assets without duplicating binaries; this example owns no content of its own. -->
  <ItemGroup>
    <Content Include="..\Duack.Sample.Desktop\Content\Audio\SFX\*.wav"
             Link="Content\Audio\SFX\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
