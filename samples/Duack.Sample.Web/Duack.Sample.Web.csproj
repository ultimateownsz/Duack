<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Duack.Sample.Web</RootNamespace>
    <AssemblyName>Duack.Sample.Web</AssemblyName>
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Duack\Duack.csproj" />
    <!-- The provisional JSON layer: the web head reads the checked-in audio-manifest.json via
         AudioLibraryManifestJson and installs the music backend that plays through the browser. -->    <ProjectReference Include="..\..\src\Duack.KNI\Duack.KNI.csproj" />
    <ProjectReference Include="..\Duack.Sample.Core\Duack.Sample.Core.csproj" />
  </ItemGroup>

  <!-- Copy shared audio content from the desktop sample so there's a single source of truth.
       Mirrors FlatRedBall2's Common/Content pattern. After adding new files, regenerate the web
       manifest with: dotnet run -project tools/DuackCli scan samples/Duack.Sample.Web/wwwroot/Content/Audio -->
  <ItemGroup>
    <SharedAudioContent Include="..\Duack.Sample.Desktop\Content\Audio\**\*.*"
                       Exclude="..\Duack.Sample.Desktop\Content\Audio\**\audio-manifest.json" />
  </ItemGroup>
  <Target Name="CleanStaleSharedAudio"
          BeforeTargets="CopySharedAudioContent">
    <!-- Remove SFX files from web that no longer exist in desktop (keeps wwwroot clean). -->
    <ItemGroup>
      <StaleSfx Include="wwwroot\Content\Audio\SFX\*.*" Exclude="@(SharedAudioContent)" />
    </ItemGroup>
    <Delete Files="@(StaleSfx)" />
  </Target>
  <Target Name="CopySharedAudioContent"
          BeforeTargets="GenerateStaticWebAssetsManifest;AssignTargetPaths"
          Inputs="@(SharedAudioContent)"
          Outputs="@(SharedAudioContent -> '$(MSBuildProjectDirectory)\wwwroot\Content\Audio\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(SharedAudioContent)"
          DestinationFiles="@(SharedAudioContent -> '$(MSBuildProjectDirectory)\wwwroot\Content\Audio\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

