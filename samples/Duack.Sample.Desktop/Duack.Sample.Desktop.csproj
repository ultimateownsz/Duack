<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Duack.Sample.Desktop</RootNamespace>
    <AssemblyName>Duack.Sample.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Duack\Duack.csproj" />
    <ProjectReference Include="..\..\src\Duack.MonoGame\Duack.MonoGame.csproj" />
    <!-- The desktop head prints the playlists it built as JSON so the shape the tooling reads is
         visible in the console. The JSON layer is part of the core. -->
    <ProjectReference Include="..\Duack.Sample.Core\Duack.Sample.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Content\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
